{
  "Jwt": {
    "Issuer": "NotMarket.Api",
    "Audience": "NotMarket.Admin",
    "ExpirationMinutes": 120
  },
  "NoteReview": {
    "AutoApproveThreshold": 85,
    "Weights": {
      "Readability": 25,
      "CourseMatch": 25,
      "DepartmentMatch": 20,
      "ContentCompleteness": 20,
      "OriginalityAndReliability": 10
    }
  },
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-5.4",
    "PromptVersion": "note-review-v1",
    "MaxOutputTokens": 2500,
    "MaxDocumentBytes": 20971520
  },
  "NotePdfGeneration": {
    "Enabled": true,
    "Model": "gpt-5.4",
    "PromptVersion": "note-pdf-conversion-v2",
    "MaxOutputTokens": 12000,
    "CompilerPath": "tectonic",
    "TimeoutSeconds": 600,
    "MaxSourceCharacters": 200000,
    "MaxGeneratedPdfBytes": 52428800,
    "KeepFailedArtifacts": false,
    "TemplateVersion": "note-pdf-template-v5"
  },
  "AllowedHosts": "*",
  "SupabaseStorage": {
    "VerificationBucket": "student-verification",
    "NotesBucket": "note-documents"
  }
}
